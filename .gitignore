# =============================================================================
# PERMEAR — .gitignore
# Code is public. Data is private. This file enforces that boundary.
# =============================================================================

# ---------------------------------------------------------------------------
# INTERNAL DEVELOPMENT DOCUMENTS — not for public consumption
# ---------------------------------------------------------------------------
CLAUDE.md
AUDIT_PLAN.md
audit_reports/
.claude/

# ---------------------------------------------------------------------------
# HOUSEHOLD CONFIGURATION — user-specific, replace with your own
# Use configuration_example.yaml as the template.
# ---------------------------------------------------------------------------
configuration.yaml

# ---------------------------------------------------------------------------
# SECRETS — never publish
# ---------------------------------------------------------------------------
secrets.yaml
.permear_token

# ---------------------------------------------------------------------------
# PRIVATE DATA — what the system learned and how this household is configured
# These files are specific to the PM's home and must never be published.
# ---------------------------------------------------------------------------
memory/permear_memory.db
memory/permear_memory.db-shm
memory/permear_memory.db-wal
memory/guidelines.json
memory/monitored_entities.json
memory/availability_snapshot.json
memory/agent_circuit.json
memory/aras_stats.json
memory/pending_priority.json
memory/archived_errors.json
memory/pending_auto_spec.json

# Runtime lock files and stale backup remnants in memory/
memory/*.lock
memory/*.bak*
memory/*.pre_*
memory/soul.json*
memory/users.json*
memory/insights.json*
memory/gemini_circuit.json
memory/sara_stats.json

# ---------------------------------------------------------------------------
# PM CONVENIENCE SCRIPTS — not public PERMEAR features
# ---------------------------------------------------------------------------
scripts/seed_memory_test.py

# ---------------------------------------------------------------------------
# HOUSEHOLD-SPECIFIC FILES — your house, not PERMEAR core
# ---------------------------------------------------------------------------
scripts.yaml
scripts.yaml.pre_*
scenes.yaml

# ---------------------------------------------------------------------------
# HOUSEHOLD AUTOMATIONS — household-specific, not part of PERMEAR core
# ---------------------------------------------------------------------------
automations/base.yaml
automations/terrabot.yaml

# ---------------------------------------------------------------------------
# OUT-OF-SCOPE PROJECTS
# ---------------------------------------------------------------------------
terrabot/
terrabot*/
esphome/
node-red/
zigbee2mqtt/
zigbee.db
echo/

# ---------------------------------------------------------------------------
# HOME ASSISTANT RUNTIME & SYSTEM FILES
# ---------------------------------------------------------------------------
home-assistant_v2.db
home-assistant_v2.db-shm
home-assistant_v2.db-wal
home-assistant.log
home-assistant.log.1
home-assistant.log.fault
.ha_run.lock
.HA_VERSION
.storage/
.cloud/
.cache/
deps/
npm
tts/
logs/
www/
blueprints/
themes/
custom_components/

# ---------------------------------------------------------------------------
# BACKUPS & EXPORTS (private, large)
# ---------------------------------------------------------------------------
backups/
backup_midea*/
nabu_export_*.tar.gz
nabu_producao_*.tar.gz
SAFETY_pre_*.tar.gz
*.pre_secrets
*.pre_sensor_reform
*.pre_agent_rename

# ---------------------------------------------------------------------------
# PYTHON CACHE
# ---------------------------------------------------------------------------
__pycache__/
*.pyc
*.pyo
*.pyd

