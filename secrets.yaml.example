# PERMEAR v7.3 — required secrets
#
# Copy these entries into your existing /config/secrets.yaml.
# Replace placeholder values with your actual configuration.

# --- Telegram bot ---
telegram_bot_token: YOUR_TELEGRAM_BOT_TOKEN
telegram_chat_id: YOUR_TELEGRAM_CHAT_ID

# --- PERMEAR core ---
permear_chat_id: YOUR_TELEGRAM_CHAT_ID                    # same as above, scoped to PERMEAR
permear_agent_id: conversation.your_interactive_agent     # Gemini or compatible (must support Tools)
permear_person_entity: person.your_name                   # used in pre-briefing prompts

# --- PERMEAR AI Task entities (v7.3) ---
# Centralized here so you can swap providers without editing automations/permear.yaml.
# Adjust the entity IDs to match your actual HA AI Task entities.
permear_ai_task_primary: ai_task.openrouter_deepseek_v3   # DeepSeek V4-Flash via OpenRouter
permear_ai_task_secondary: ai_task.google_ai_task          # Gemini Flash fallback
