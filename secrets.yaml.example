# secrets.yaml.example — PERMEAR
#
# Copy the keys you need into your own /config/secrets.yaml.
# PERMEAR's automations reference exactly two secrets:

# The primary resident's person entity (used by the event buffer triggers).
permear_person_entity: person.your_person_entity

# The Telegram chat PERMEAR sends messages to.
telegram_chat_id: YOUR_CHAT_ID

# Note: AI providers are NOT secrets in v8 — configure them in permear.yaml.
# Note: your Telegram bot token belongs to the Home Assistant telegram_bot
#       integration (in configuration.yaml), not here.
