# PERMEAR v7.2 — required secrets
#
# Copy these entries into your existing /config/secrets.yaml.
# Replace placeholder values with your actual configuration.

# --- Telegram bot ---
telegram_bot_token: YOUR_TELEGRAM_BOT_TOKEN
telegram_chat_id: YOUR_TELEGRAM_CHAT_ID   # used by HA telegram_bot integration

# --- PERMEAR specific ---
permear_chat_id: YOUR_TELEGRAM_CHAT_ID    # same as above, scoped to PERMEAR
permear_agent_id: conversation.your_interactive_agent   # Gemini or compatible (must support Tools)
permear_person_entity: person.your_name                 # used in pre-briefing prompts
